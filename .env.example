# Standalone clones may copy these settings to ignored .private/openai.env.
# A Book Power workspace instead shares the durable key from ../book-power/.env.
OPENAI_API_KEY=
# The tracked pilot fixture currently pins this to gpt-5-mini.
OPENAI_EXTRACTION_MODEL=
OPENAI_VERIFICATION_MODEL=

# Optional hosted usage telemetry. Only operational metadata is sent; tool
# arguments, results, source content, entry IDs, and user identities are not.
POSTHOG_API_KEY=
